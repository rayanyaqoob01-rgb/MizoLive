rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidMedia(maxBytes, contentTypePrefix) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches(contentTypePrefix);
    }

    // Profile avatars & covers (max 5 MB image)
    match /users/{uid}/profile/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid
        && isValidMedia(5 * 1024 * 1024, 'image/.*');
    }

    // Live & Room covers (max 5 MB image)
    match /rooms/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid
        && isValidMedia(5 * 1024 * 1024, 'image/.*');
    }

    // Uploaded short-form videos & thumbnails (max 60 MB video or 5 MB image)
    match /videos/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid
        && (isValidMedia(60 * 1024 * 1024, 'video/.*') || isValidMedia(5 * 1024 * 1024, 'image/.*'));
    }

    // Chat media attachments (max 10 MB image)
    match /chats/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid
        && isValidMedia(10 * 1024 * 1024, 'image/.*');
    }
  }
}
