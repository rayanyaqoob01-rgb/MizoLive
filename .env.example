# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Configurable Mizo Live Calling Economy (Server-Side)
CALL_AUDIO_RATE="40"
CALL_VIDEO_RATE="90"
PLATFORM_COMMISSION_PCT="20"

# Agora Real-Time Streaming, PK Battle, Rooms & Audio/Video Calling (Server-Side Secrets)
# Never expose AGORA_APP_CERTIFICATE on the client!
AGORA_APP_ID="MY_AGORA_APP_ID"
AGORA_APP_CERTIFICATE="MY_AGORA_APP_CERTIFICATE"

# Admin Diagnostics Access (Authoritative server-verified admin email)
ADMIN_EMAIL="rayanyaqoob01@gmail.com"

# Optional Firebase Web Push (FCM), App Check & Facebook Auth (Public Web Keys)
VITE_FIREBASE_VAPID_KEY=""
VITE_FIREBASE_APPCHECK_KEY=""
VITE_FACEBOOK_APP_ID=""

# Android Release Signing (CI / Local Release Build Only - never commit real keystores)
MIZO_KEYSTORE_PATH=""
MIZO_KEYSTORE_PASSWORD=""
MIZO_KEY_ALIAS=""
MIZO_KEY_PASSWORD=""

# Comma-separated allowed browser origins for Flutter Web / Firebase Hosting CORS
ALLOWED_ORIGINS="https://gen-lang-client-0785177825.web.app,https://gen-lang-client-0785177825.firebaseapp.com"

